# ==========================================
# X-Ray Business Environment Configuration
# ==========================================
# Скопируйте этот файл в .env и укажите ваши значения:
# cp .env.example .env

# --- Django Application Settings ---
DEBUG=false
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-for-production
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,https://xray-business-bot.online

# --- Database Settings (PostgreSQL) ---
DB_ENGINE=postgres
POSTGRES_DB=xray_db
POSTGRES_USER=xray_user
POSTGRES_PASSWORD=xray_secret_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- AI & LLM Providers ---
# Google Gemini API key для генерации нарратива аудита и чат-ассистента
GEMINI_API_KEY=your_gemini_api_key_here

# --- MAX Platform & Messengers ---
# Токен бота платформы MAX, предоставленный организаторами
MAX_BOT_TOKEN=your_max_bot_token_here

# --- Frontend API Config ---
VITE_API_BASE_URL=http://localhost:8000
